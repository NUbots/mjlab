# Weights & Biases API key for training logs.
#
# Do not commit real credentials. Create the secret directly:
#
#   kubectl -n mjlab create secret generic mjlab-wandb \
#     --from-literal=WANDB_API_KEY=your-key-here
#
# Or copy this file to secret-wandb.yaml, fill in WANDB_API_KEY, and
# uncomment secret-wandb.yaml in kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: mjlab-wandb
  namespace: mjlab
type: Opaque
stringData:
  WANDB_API_KEY: replace-me
