# Optional: credentials for cloning a private fork.
# Copy to secret-git.yaml, fill in values, uncomment in kustomization.yaml.
#
# For HTTPS with a personal access token, set GIT_REPO to:
#   https://<token>@github.com/your-org/mjlab.git
apiVersion: v1
kind: Secret
metadata:
  name: mjlab-git-credentials
  namespace: mjlab
type: Opaque
stringData:
  # Example: base64-encoded .git-credentials line (not used by default entrypoint).
  GIT_TOKEN: replace-me
